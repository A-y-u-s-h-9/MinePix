<Window x:Class="MinePix.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinePix — Settings"
        Width="580" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1F161A21"
        AllowsTransparency="False">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="#141FFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- iOS-style pill switch -->
        <Style x:Key="IslandSwitch" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13" Width="44" Height="26" Padding="3">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#F5F5F7" HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#8AB4FF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- island flat button -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8AB4FF"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#141FFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatButtonDanger" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="#FF6E6E"/>
        </Style>

        <!-- segmented theme buttons -->
        <Style x:Key="ThemeButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#B8B8BD"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#8AB4FF"/>
                    <Setter Property="Foreground" Value="#0D1B2A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- outer frame -->
    <Border CornerRadius="22" Background="#261E1F25" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="22,22,0,0" Height="44" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#8AB4FF"/>
                        <TextBlock Text="MinePix — Settings" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                            Padding="12,4" Foreground="#C8C9CD" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- scrollable content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,16">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" Margin="0,12,0,8"/>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Graphite / Glass / Solid — how the island body looks" Style="{StaticResource SettingHint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ToggleButton x:Name="ThemeGraphite" Style="{StaticResource ThemeButton}" Content="Graphite" Click="ThemeGraphite_Click"/>
                                <ToggleButton x:Name="ThemeGlass" Style="{StaticResource ThemeButton}" Content="Glass" Click="ThemeGlass_Click"/>
                                <ToggleButton x:Name="ThemeBlack" Style="{StaticResource ThemeButton}" Content="Solid" Click="ThemeBlack_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dynamic island mode" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="iPhone-style pill that liquid-expands on hover. Off keeps the slimmer classic pill." Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <ToggleButton x:Name="IslandModeSwitch" Style="{StaticResource IslandSwitch}"
                                          Grid.Column="1" VerticalAlignment="Center" Click="IslandModeSwitch_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Music in collapsed pill" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Shows the music note glyph + track name in the pill when something is playing" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <ToggleButton x:Name="MusicInPillSwitch" Style="{StaticResource IslandSwitch}"
                                          Grid.Column="1" VerticalAlignment="Center" Click="MusicInPillSwitch_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="MinePix runs in the tray at sign-in" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <ToggleButton x:Name="StartWithWindowsSwitch" Style="{StaticResource IslandSwitch}"
                                          Grid.Column="1" VerticalAlignment="Center" Click="StartWithWindowsSwitch_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Clipboard history" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Watch your clipboard for history. Never leaves your PC." Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <ToggleButton x:Name="ClipboardEnabledSwitch" Style="{StaticResource IslandSwitch}"
                                          Grid.Column="1" VerticalAlignment="Center" Click="ClipboardEnabledSwitch_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Collapsed width" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="CollapsedWidthSlider" Minimum="180" Maximum="360" TickPlacement="None"
                                        Value="220" Margin="0,8,0,0" ValueChanged="CollapsedWidthSlider_ValueChanged"/>
                                <TextBlock x:Name="CollapsedWidthLabel" Text="220 px" Foreground="#8E8E93" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expanded height" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="ExpandedHeightSlider" Minimum="120" Maximum="420" TickPlacement="None"
                                        Value="235" Margin="0,8,0,0" ValueChanged="ExpandedHeightSlider_ValueChanged"/>
                                <TextBlock x:Name="ExpandedHeightLabel" Text="235 px" Foreground="#8E8E93" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Collapse delay" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="How long to wait after the pointer leaves before collapsing the island" Style="{StaticResource SettingHint}"/>
                            <Slider x:Name="CollapseDelaySlider" Minimum="100" Maximum="1000" TickPlacement="None"
                                    Value="250" Margin="0,8,0,0" ValueChanged="CollapseDelaySlider_ValueChanged"/>
                            <TextBlock x:Name="CollapseDelayLabel" Text="250 ms" Foreground="#8E8E93" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="MinePix — your top edge, doing things" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="A free, open-source Dynamic Island for Windows. Version 0.3.0" Style="{StaticResource SettingHint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource FlatButton}" Content="Open settings folder" Click="OpenSettingsFolder_Click"/>
                                <Button Style="{StaticResource FlatButton}" Content="View on GitHub" Margin="8,0,0,0" Click="OpenGitHub_Click"/>
                                <Button Style="{StaticResource FlatButton}" Content="Check for updates" Margin="8,0,0,0" Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
