<Window x:Class="MinePix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinePix"
        Width="220" Height="34"
        Top="0"
        Left="0"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Border x:Name="Island"
            CornerRadius="0,0,18,18"
            Background="#D91C1B1F"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1,0,1,1"
            Padding="16,0">
        <Grid>
            <!-- Collapsed pill -->
            <Grid x:Name="PillView">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" Fill="#8AB4FF" VerticalAlignment="Center"/>
                    <TextBlock Text="MinePix"
                               Foreground="#F5F5F7"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PillClock"
                           Text="--:--"
                           Foreground="#B8B8BD"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded card -->
            <Grid x:Name="ExpandedView"
                  Visibility="Collapsed"
                  Opacity="0"
                  Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#8AB4FF" VerticalAlignment="Center"/>
                        <TextBlock Text="MinePix"
                                   Foreground="#F5F5F7"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="M1 · skeleton"
                               Foreground="#8E8E93"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#1FFFFFFF" Margin="0,8"/>

                <!-- Feature stack (placeholders until M3–M8 land) -->
                <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Music · soon" Foreground="#D5D5DA" FontSize="12" FontFamily="Segoe UI"/></Border>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Clipboard · soon" Foreground="#D5D5DA" FontSize="12" FontFamily="Segoe UI"/></Border>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Controls · soon" Foreground="#D5D5DA" FontSize="12" FontFamily="Segoe UI"/></Border>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Reminders · soon" Foreground="#D5D5DA" FontSize="12" FontFamily="Segoe UI"/></Border>
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,0,0,8"><TextBlock Text="FPS · soon" Foreground="#D5D5DA" FontSize="12" FontFamily="Segoe UI"/></Border>
                </WrapPanel>

                <TextBlock Grid.Row="3"
                           Text="Hover to browse · pointer away to collapse"
                           Foreground="#6E6E73"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
