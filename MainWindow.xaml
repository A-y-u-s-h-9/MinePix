<Window x:Class="MinePix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="MinePix"
        Width="720" Height="480"
        Top="0"
        Left="0"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        UseLayoutRounding="True">
    <Window.Resources>

        <!-- =================== reusable bits =================== -->

        <!-- page tile used everywhere: near-opaque dark rounded tile -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#AD1E2026"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#08FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- subtle card row used for list cells -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- large action button (Screenshot / Snip / Record) -->
        <Style x:Key="BigActionButton" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- icon bar button -->
        <Style x:Key="IconButton" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                    <Setter Property="Foreground" Value="#F5F5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- icon button active (selected page) -->
        <Style x:Key="IconButtonActive" TargetType="{x:Type primitives:ButtonBase}" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
        </Style>

        <!-- category chip for filter tabs -->
        <Style x:Key="CategoryChip" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#C8C9CD"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F1F1F"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- selected category chip: white pill -->
        <Style x:Key="CategoryChipSelected" TargetType="{x:Type primitives:ButtonBase}" BasedOn="{StaticResource CategoryChip}">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1B1F"/>
        </Style>

        <!-- slim glass scrollbar for the card list -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="7">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#3DFFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3.5"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#5CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style flat button used for settings/footer links -->
        <Style x:Key="IslandFlatButton" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8AB4FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#141FFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- big circle connector card (floating bell between cards on Home) -->
        <Style x:Key="FloatingCircleButton" TargetType="{x:Type primitives:ButtonBase}">
            <Setter Property="Background" Value="#141B24"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="32" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- =================== THE ISLAND =================== -->
    <Border x:Name="Island"
            CornerRadius="28"
            Background="#E6100F10"
            BorderBrush="#0FFFFFFF"
            BorderThickness="1"
            Padding="0"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Direction="90" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <!-- Collapsed pill -->
            <Grid x:Name="PillView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- left: app logo -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="6,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A3D" Offset="0"/>
                            <GradientStop Color="#FF2A68" Offset="0.38"/>
                            <GradientStop Color="#7A1FE0" Offset="0.76"/>
                            <GradientStop Color="#301060" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="12" Height="12" Fill="#FFD166" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    </Grid>
                </Border>
                <!-- right: pixel-grid glyph -->
                <TextBlock Grid.Column="2" x:Name="PillGlyph" Text="▮▮▮&#10;▮▮▮&#10;▮▮▮"
                           FontFamily="Consolas" Foreground="#FF5A5A" FontSize="7" LineHeight="8"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
            </Grid>

            <!-- Expanded card -->
            <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- icon bar -->
                <Grid Grid.Row="0" x:Name="IconBar" Margin="10,10,10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="IconMusic"    Style="{StaticResource IconButtonActive}" Content="&#x266A;" Click="IconMusic_Click" Tag="music"/>
                        <Button x:Name="IconGlobe"    Style="{StaticResource IconButton}" Content="&#x1F310;" Click="IconGlobe_Click" Tag="globe"/>
                        <Button x:Name="IconBell"     Style="{StaticResource IconButton}" Content="&#x1F514;" Click="IconBell_Click" Tag="bell"/>
                        <Button x:Name="IconChat"     Style="{StaticResource IconButton}" Content="&#x1F4AC;" Click="IconChat_Click" Tag="chat"/>
                        <Button x:Name="IconFolder"   Style="{StaticResource IconButton}" Content="&#x1F4C1;" Click="IconFolder_Click" Tag="folder"/>
                        <Button x:Name="IconClipboard" Style="{StaticResource IconButton}" Content="&#x1F4CB;" Click="IconClipboard_Click" Tag="clipboard"/>
                        <Button x:Name="IconGrid"     Style="{StaticResource IconButton}" Content="&#x25BB;" Click="IconGrid_Click" Tag="apps"/>
                        <Button x:Name="IconSliders"  Style="{StaticResource IconButton}" Content="&#x1D49E;" Click="IconSliders_Click" Tag="controls"/>
                        <Button x:Name="IconHeadphones" Style="{StaticResource IconButton}" Content="&#x1F3A7;" Click="IconHeadphones_Click" Tag="bluetooth"/>
                        <Button x:Name="IconActions"  Style="{StaticResource IconButton}" Content="&#x2795;" Click="IconActions_Click" Tag="actions"/>
                        <Button x:Name="IconSettings" Style="{StaticResource IconButton}" Content="&#x2699;" Click="IconSettings_Click" Tag="settings"/>
                    </StackPanel>
                </Grid>

                <!-- page area -->
                <Grid Grid.Row="1" x:Name="PageArea" Margin="12,10,12,14">

                    <!-- =========== HOME =========== -->
                    <Grid x:Name="PageHome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- clock card -->
                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource Tile}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeClock" Text="7:05" Foreground="#F5F5F7"
                                               FontFamily="Segoe UI Semibold" FontSize="48"/>
                                    <TextBlock x:Name="HomeDay" Text="TUE" Foreground="#8E8E93"
                                               FontFamily="Segoe UI Semibold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Tokyo" Foreground="#C8C9CD" FontFamily="Segoe UI" FontSize="11"/>
                                    <TextBlock x:Name="HomeTokyoClock" Text="10:35 PM" Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="11" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- to-do card -->
                        <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" Style="{StaticResource Tile}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="To do 2" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="14"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="16" Height="16" Stroke="#6E6E73" StrokeThickness="1.5"/>
                                        <TextBlock Text="Send the invoice" Foreground="#C8C9CD" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse Width="16" Height="16" Stroke="#6E6E73" StrokeThickness="1.5"/>
                                        <TextBlock Text="Book the dentist" Foreground="#C8C9CD" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- weather card -->
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,6,6,0" Style="{StaticResource Tile}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F324;" FontSize="40" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="20°" Foreground="#FFD166" FontFamily="Segoe UI Semibold" FontSize="28"/>
                                    <TextBlock Text="Sunny · London" Foreground="#8E8E93" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- PC battery card -->
                        <Border Grid.Row="1" Grid.Column="1" Margin="6,6,0,0" Style="{StaticResource Tile}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="This PC" Foreground="#8E8E93" FontFamily="Segoe UI Semibold" FontSize="12"/>
                                    <TextBlock x:Name="HomeBatteryPercent" Text="100%" Foreground="#30D158" FontFamily="Segoe UI Semibold" FontSize="40"/>
                                    <TextBlock x:Name="HomeBatteryStatus" Text="Plugged in" Foreground="#6E6E73" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- floating bell -->
                        <Button x:Name="HomeBellFloating" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Style="{StaticResource FloatingCircleButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,0,0,0" Click="HomeBellFloating_Click">
                            <TextBlock Text="🔔" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- =========== MUSIC =========== -->
                    <Grid x:Name="PageMusic" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- album art placeholder (same gradient as pill) -->
                        <Border Width="156" Height="156" CornerRadius="16" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF6A3D" Offset="0"/>
                                    <GradientStop Color="#FF2A68" Offset="0.45"/>
                                    <GradientStop Color="#7A1FE0" Offset="0.78"/>
                                    <GradientStop Color="#301060" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock x:Name="MusicArtFallback" Text="&#x266A;" Foreground="#F5F5F7" FontSize="88"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="MusicArt" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MusicTitle" Text="" Grid.Row="0" Foreground="#F5F5F7"
                                       FontFamily="Segoe UI Semibold" FontSize="22" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                            <TextBlock x:Name="MusicArtist" Text="" Grid.Row="1" Foreground="#C8C9CD"
                                       FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <!-- transport -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <Button x:Name="MusicPrevButton" Style="{StaticResource IconButton}" Content="&#x23EE;"
                                        Width="44" Height="44" FontSize="22" Click="MusicPrevButton_Click"/>
                                <Button x:Name="MusicPlayPauseButton" Style="{StaticResource IconButtonActive}" Content="&#x23F8;"
                                        Width="56" Height="56" FontSize="26" Margin="4,0,4,0" Click="MusicPlayPauseButton_Click"/>
                                <Button x:Name="MusicNextButton" Style="{StaticResource IconButton}" Content="&#x23ED;"
                                        Width="44" Height="44" FontSize="22" Click="MusicNextButton_Click"/>
                            </StackPanel>
                            <!-- progress -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MusicPosition" Text="0:00" Foreground="#8E8E93" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border x:Name="SeekTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                                        MouseDown="SeekTrack_MouseDown" MouseMove="SeekTrack_MouseMove" MouseUp="SeekTrack_MouseUp">
                                    <Grid VerticalAlignment="Center">
                                        <Border Height="3" CornerRadius="1.5" Background="#1FFFFFFF"/>
                                        <Border x:Name="SeekFill" Height="3" CornerRadius="1.5" Background="#FF7A3D"
                                                Width="0"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="MusicDuration" Grid.Column="2" Text="0:00" Foreground="#8E8E93" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- volume -->
                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F50A;" Foreground="#C8C9CD" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="VolumeTrack" Grid.Column="1" Height="12" Background="Transparent" Cursor="Hand"
                                        MouseDown="VolumeTrack_MouseDown" MouseMove="VolumeTrack_MouseMove" MouseUp="VolumeTrack_MouseUp">
                                    <Grid VerticalAlignment="Center">
                                        <Border Height="3" CornerRadius="1.5" Background="#1FFFFFFF"/>
                                        <Border x:Name="VolumeFill" Height="3" CornerRadius="1.5" Background="#F5F5F7"
                                                Width="0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- =========== CLIPBOARD =========== -->
                    <Grid x:Name="PageClipboard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- category chips -->
                        <StackPanel x:Name="ClipCategoryBar" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="ClipCatAll"     Style="{StaticResource CategoryChipSelected}" Content="All"    Click="ClipCatAll_Click"/>
                            <Button x:Name="ClipCatText"    Style="{StaticResource CategoryChip}" Content="Text"   Click="ClipCatText_Click"/>
                            <Button x:Name="ClipCatLinks"   Style="{StaticResource CategoryChip}" Content="Links"  Click="ClipCatLinks_Click"/>
                            <Button x:Name="ClipCatImages"  Style="{StaticResource CategoryChip}" Content="Images" Click="ClipCatImages_Click"/>
                            <Button x:Name="ClipCatFiles"   Style="{StaticResource CategoryChip}" Content="Files"  Click="ClipCatFiles_Click"/>
                            <Button x:Name="ClipCatSnippets" Style="{StaticResource CategoryChip}" Content="Snippets" Click="ClipCatSnippets_Click"/>
                            <Button x:Name="ClipClearAll"   Style="{StaticResource CategoryChip}" Content="Clear"  Click="ClipClearAllButton_Click" Margin="0,0,0,6"/>
                        </StackPanel>
                        <!-- card grid -->
                        <ScrollViewer x:Name="ClipboardScroll" Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ClipCardGrid" Orientation="Horizontal" ItemWidth="132" ItemHeight="152"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Clipboard is empty — copy something"
                                   Foreground="#6E6E73" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- =========== CONTROLS =========== -->
                    <Grid x:Name="PageControls" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- big vertical sliders -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <!-- brightness -->
                            <Grid Width="62" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="BrightnessPercent" Text="80%" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <Border x:Name="BrightnessTrack" Grid.Row="1" Width="52" CornerRadius="14" Background="#141B22"
                                        ClipToBounds="True" Cursor="Hand"
                                        MouseDown="BrightnessTrack_MouseDown" MouseMove="BrightnessTrack_MouseMove" MouseUp="BrightnessTrack_MouseUp">
                                    <Border x:Name="BrightnessFill" Background="#F5F5F7" CornerRadius="12" VerticalAlignment="Bottom" Height="0"/>
                                </Border>
                            </Grid>
                            <!-- volume -->
                            <Grid Width="62">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="VolumePercent" Text="0%" Foreground="#8E8E93" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <Border x:Name="VolumeTrackVertical" Grid.Row="1" Width="52" CornerRadius="14" Background="#141B22"
                                        ClipToBounds="True" Cursor="Hand"
                                        MouseDown="VolumeTrackVertical_MouseDown" MouseMove="VolumeTrackVertical_MouseMove" MouseUp="VolumeTrackVertical_MouseUp">
                                    <Border x:Name="VolumeFillVertical" Background="#FFFFFF" CornerRadius="12" VerticalAlignment="Bottom" Height="0"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <!-- tiles grid on right -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Row 1: Wi-Fi / BT / Nightly -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="WifiToggle" Grid.Column="0" Content="&#x1F4F6;" Style="{StaticResource IconButtonActive}"
                                              Margin="0,0,4,0" Click="WifiToggle_Click"/>
                                <ToggleButton x:Name="BluetoothToggle" Grid.Column="1" Content="BT" Style="{StaticResource IconButton}"
                                              Margin="2,0,2,0" Click="BluetoothToggle_Click"/>
                                <ToggleButton x:Name="NightLightToggle" Grid.Column="2" Content="&#x263E;" Style="{StaticResource IconButton}"
                                              Margin="4,0,0,0" Click="NightLightToggle_Click"/>
                            </Grid>
                            <!-- Row 2: Focus / Mute / Battery -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="FocusToggle" Grid.Column="0" Content="&#x1F319;" Style="{StaticResource IconButton}"
                                              Margin="0,0,4,0" Click="FocusToggle_Click"/>
                                <ToggleButton x:Name="MuteToggle" Grid.Column="1" Content="&#x1F50A;" Style="{StaticResource IconButton}"
                                              Margin="2,0,2,0" Click="MuteToggle_Click"/>
                                <Border Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource Tile}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="100%" x:Name="ControlsBatteryPercent" Foreground="#30D158" FontFamily="Segoe UI Semibold" FontSize="18"/>
                                        <TextBlock Text="Plugged in" x:Name="ControlsBatteryStatus" Foreground="#6E6E73" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- =========== ACTIONS =========== -->
                    <Grid x:Name="PageActions" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- top row: three direct-action buttons -->
                        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,10">
                            <Button x:Name="ActionScreenshot" Style="{StaticResource BigActionButton}" Margin="0,0,4,0"
                                    Click="ActionScreenshot_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F4F7;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Screenshot" Foreground="#F5F5F7" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ActionSnip" Style="{StaticResource BigActionButton}" Margin="4,0,4,0"
                                    Click="ActionSnip_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2702;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Snip" Foreground="#F5F5F7" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ActionRecord" Style="{StaticResource BigActionButton}" Margin="4,0,0,0"
                                    Click="ActionRecord_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="●" FontSize="16" Foreground="#FF453A" VerticalAlignment="Center"/>
                                    <TextBlock Text="Record" Foreground="#F5F5F7" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <!-- shortcut grid of dashed cells -->
                        <WrapPanel x:Name="ShortcutGrid" Grid.Row="1" Orientation="Horizontal" ItemWidth="96" ItemHeight="110">
                            <!-- filled programmatically or left as dashed placeholders -->
                        </WrapPanel>
                    </Grid>

                    <!-- =========== SETTINGS =========== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Settings" Grid.Row="0" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Theme" Foreground="#8E8E93" FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,2,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CategoryChipSelected}" Content="Dark"/>
                                    <Button Style="{StaticResource CategoryChip}" Content="Light"/>
                                </StackPanel>
                                <TextBlock Text="" />
                                <TextBlock Text="Start with Windows" Foreground="#8E8E93" FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,2,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CategoryChipSelected}" Content="On"/>
                                    <Button Style="{StaticResource CategoryChip}" Content="Off"/>
                                </StackPanel>
                                <TextBlock Text="" />
                                <TextBlock Text="About" Foreground="#8E8E93" FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,2,0,6"/>
                                <TextBlock x:Name="SettingsVersionLine" Text="MinePix — your top edge, doing things."
                                           Foreground="#C8C9CD" FontFamily="Segoe UI" FontSize="12"/>
                                <TextBlock Text="&#xA;"/>
                                <Button x:Name="SettingsOpenStore" Style="{StaticResource IslandFlatButton}" Content="Open settings folder" Click="SettingsOpenStore_Click" HorizontalAlignment="Left"/>
                                <Button x:Name="SettingsOpenRepo" Style="{StaticResource IslandFlatButton}" Content="Open source on GitHub" Click="SettingsOpenRepo_Click" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =========== BELL / NOTIFICATIONS (placeholder shell) =========== -->
                    <Grid x:Name="PageBell" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="Notifications" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Windows can't share other apps' notifications without &#xA;MSIX packaging. Coming in M6."
                                       Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- =========== CHAT / STREAM (placeholder shell) =========== -->
                    <Grid x:Name="PageChat" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="💬" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stream chat" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Connect Twitch/YouTube live chat in a later milestone."
                                       Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- =========== FOLDER / FILE SHELF (placeholder shell) =========== -->
                    <Grid x:Name="PageFolder" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="File shelf" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Pin files across restarts. In the next milestone."
                                       Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- =========== APPS / GRID (placeholder shell) =========== -->
                    <Grid x:Name="PageApps" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▦" FontSize="56" Foreground="#C8C9CD" HorizontalAlignment="Center"/>
                            <TextBlock Text="App launcher" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Launch pinned apps in the next milestone."
                                       Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- =========== GLOBE (placeholder) =========== -->
                    <Grid x:Name="PageGlobe" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quick links" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="Pin any page, open it from the island. Coming soon."
                                       Foreground="#8E8E93" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

