<Window x:Class="MinePix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinePix"
        Width="220" Height="34"
        Top="0"
        Left="0"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <!-- iOS-style control tiles -->
        <Style x:Key="IslandMasterTile" TargetType="Border">
            <Setter Property="Background" Value="#AD20232A"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- colourless circle toggle: only the glyph colors when active -->
        <Style x:Key="IslandCircleToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Border Background="{TemplateBinding Background}" CornerRadius="28" Width="56" Height="56">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#8AB4FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D5D5DA"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="72"/>
        </Style>

        <Style x:Key="IslandCaptionSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="72"/>
        </Style>

        <!-- iOS-style pill switch -->
        <Style x:Key="IslandSwitch" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13" Width="46" Height="26" Padding="3">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#F5F5F7" HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#8AB4FF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="7">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#3DFFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3.5"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#5CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bottom edge: light pooling along the notch, bright at center -->
        <LinearGradientBrush x:Key="BottomRimBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#08FFFFFF" Offset="0"/>
            <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- flat island buttons -->
        <Style x:Key="IslandTabButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#B8B8BD"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                    <Setter Property="Foreground" Value="#F5F5F7"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- icon nav buttons in header: iOS-like orbs -->
        <Style x:Key="IslandIconButton" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#B8B8BD"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="ToolTip" Value=""/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                    <Setter Property="Foreground" Value="#F5F5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandIconButtonActive" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="IslandFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5F5F7"/>
                    <Setter Property="Background" Value="#14FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandFlatDanger" TargetType="Button" BasedOn="{StaticResource IslandFlatButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF6E6E"/>
                    <Setter Property="Background" Value="#1FFF6E6E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- clipboard row buttons -->
        <Style x:Key="ClipMiniButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5F5F7"/>
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClipPinButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFD60A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandButtonLarge" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Island"
            CornerRadius="0,0,18,18"
            Background="#591E1D23"
            BorderBrush="{StaticResource BottomRimBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="90" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <!-- Collapsed pill -->
            <Grid x:Name="PillView">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#8AB4FF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PillNote" Text="&#x266A;" Foreground="#8AB4FF" FontSize="13"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="PillTitle" Text="MinePix"
                               Foreground="#F5F5F7"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13"
                               Margin="8,0,0,0"
                               MaxWidth="120"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PillClock"
                           Text="--:--"
                           Foreground="#B8B8BD"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded card -->
            <Grid x:Name="ExpandedView"
                  Visibility="Collapsed"
                  Opacity="0"
                  Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#8AB4FF" VerticalAlignment="Center"/>
                        <TextBlock Text="MinePix"
                                   Foreground="#F5F5F7"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="IconBar">
                        <Button x:Name="IconMusic"     Content="&#x266A;" Style="{StaticResource IslandIconButton}" Click="IconMusic_Click"     Tag="music"     ToolTip="Music"/>
                        <Button x:Name="IconClipboard" Content="&#x1F4CB;" Style="{StaticResource IslandIconButton}" Click="IconClipboard_Click" Tag="clipboard" ToolTip="Clipboard"/>
                        <Button x:Name="IconControls"  Content="&#x2503;" Style="{StaticResource IslandIconButton}" Click="IconControls_Click"  Tag="controls"  ToolTip="Controls"/>
                        <Button x:Name="IconSettings"  Content="&#x2699;" Style="{StaticResource IslandIconButton}" Click="IconSettings_Click"  Tag="settings"  ToolTip="Settings"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#1FFFFFFF" Margin="0,8"/>

                <!-- Music card -->
                <Border Grid.Row="2" x:Name="MusicCard" Background="#3814171C" CornerRadius="14"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        Padding="10" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- artwork -->
                        <Border Width="64" Height="64" CornerRadius="12" Background="#1FFFFFFF" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="MusicArtPlaceholder" Text="&#x266A;" Foreground="#8AB4FF"
                                           FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="MusicArt" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="MusicTitle" Text="" Foreground="#F5F5F7"
                                       FontFamily="Segoe UI Semibold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MusicArtist" Grid.Row="1" Text="" Foreground="#A9A9AF"
                                       FontFamily="Segoe UI" FontSize="11" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- seek bar -->
                            <Grid Grid.Row="2" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MusicPos" Text="0:00" Foreground="#8E8E93" FontSize="9" VerticalAlignment="Center"/>
                                <Border x:Name="SeekTrack" Grid.Column="1" Height="14" Background="Transparent"
                                        Cursor="Hand" MouseDown="SeekTrack_MouseDown"
                                        MouseMove="SeekTrack_MouseMove" MouseUp="SeekTrack_MouseUp">
                                    <Grid VerticalAlignment="Center">
                                        <Border Height="3" CornerRadius="1.5" Background="#2EFFFFFF"/>
                                        <Border x:Name="SeekFill" Height="3" CornerRadius="1.5" Background="#8AB4FF"
                                                HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="MusicDuration" Grid.Column="2" Text="0:00" Foreground="#8E8E93" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- controls -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="0,6,0,0">
                                <Button x:Name="PrevButton" Content="&#x23EE;" Style="{StaticResource IslandButton}"
                                        Click="PrevButton_Click" ToolTip="Previous track"/>
                                <Button x:Name="PlayPauseButton" Content="&#x23F8;" Style="{StaticResource IslandButtonLarge}"
                                        Margin="8,0,8,0" Click="PlayPauseButton_Click" ToolTip="Play / pause"/>
                                <Button x:Name="NextButton" Content="&#x23ED;" Style="{StaticResource IslandButton}"
                                        Click="NextButton_Click" ToolTip="Next track"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Clipboard panel -->
                <Border Grid.Row="2" x:Name="ClipPanel" Background="#A626272C" CornerRadius="14"
                        BorderBrush="#14FFFFFF" BorderThickness="1"
                        Padding="8" Visibility="Collapsed">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- search -->
                    <Border Grid.Row="0" CornerRadius="10" Background="#14FFFFFF" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <TextBox x:Name="ClipSearch" Background="Transparent" BorderThickness="0"
                                     Foreground="#F5F5F7" CaretBrush="#F5F5F7" FontSize="12"
                                     FontFamily="Segoe UI" TextChanged="ClipSearch_TextChanged"/>
                            <TextBlock x:Name="ClipSearchPlaceholder" Text="Search clipboard…" Foreground="#6E6E73"
                                       FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- items -->
                    <ListBox Grid.Row="1" x:Name="ClipList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8,6" MouseLeftButtonUp="ClipRow_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="26" Height="26" Fill="#1FFFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Glyph}" Foreground="#8AB4FF" FontSize="12"
                                                   FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Preview}" Foreground="#F5F5F7" FontSize="12"
                                                       FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            <TextBlock Foreground="#8E8E93" FontSize="9" FontFamily="Segoe UI"
                                                       Text="{Binding MetaLine}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="☆" Tag="{Binding Id}" IsChecked="{Binding Pinned, Mode=TwoWay}"
                                                          Style="{StaticResource ClipPinButton}" Click="ClipPin_Click" ToolTip="Pin"/>
                                            <Button Content="×" Tag="{Binding Id}" Style="{StaticResource ClipMiniButton}"
                                                    Click="ClipDelete_Click" ToolTip="Remove"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Clipboard is empty — copy something"
                               Foreground="#6E6E73" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="Collapsed"/>

                    <Border Grid.Row="2" Height="1" Background="#1FFFFFFF" Margin="0,6"/>

                    <Grid Grid.Row="3">
                        <TextBlock x:Name="ClipCount" Text="0 items" Foreground="#8E8E93" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClipStatus" Text="Copied ✓" Foreground="#8AB4FF" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClipClearUnpinned" Content="Clear unpinned" Style="{StaticResource IslandFlatButton}"
                                    Click="ClipClearUnpinned_Click"/>
                            <Button x:Name="ClipClearAll" Content="Clear all" Style="{StaticResource IslandFlatDanger}"
                                    Margin="6,0,0,0" Click="ClipClearAll_Click"/>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>

        <!-- selector sheet (Wi-Fi / Bluetooth) -->
        <Grid Grid.Row="2" x:Name="SelectorPanel" Visibility="Collapsed"
              Background="#D525262C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectorBackButton" Style="{StaticResource IslandFlatButton}"
                            FontSize="16" Padding="4,0" Click="SelectorBack_Click" ToolTip="Back">
                        <TextBlock Text="&#x2039;" Foreground="#F5F5F7" FontFamily="Segoe UI Semibold"
                                   FontSize="22" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock x:Name="SelectorTitle" Text="" Foreground="#F5F5F7"
                               FontFamily="Segoe UI Semibold" FontSize="14"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button x:Name="SelectorRefreshButton" Content="&#x21bb;" Style="{StaticResource IslandFlatButton}"
                        FontSize="16" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="SelectorRefresh_Click" ToolTip="Refresh list"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#1FFFFFFF" Margin="0,10,0,4"/>

            <!-- radio master toggle row -->
            <Grid Grid.Row="2" Margin="0,2,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Ellipse x:Name="SelectorGlyphCircle" Width="46" Height="46" Fill="#1FFFFFFF"/>
                        <TextBlock x:Name="SelectorGlyph" Text="📶" FontSize="22" FontFamily="Segoe UI Emoji"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectorRadioName" Text="Wi-Fi" Foreground="#F5F5F7"
                                   FontFamily="Segoe UI Semibold" FontSize="13"/>
                        <TextBlock x:Name="SelectorRadioState" Text="On" Foreground="#8E8E93"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ToggleButton x:Name="SelectorRadioSwitch" Style="{StaticResource IslandSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="SelectorRadioSwitch_Click"/>
            </Grid>

            <!-- rows -->
            <ListBox Grid.Row="3" x:Name="SelectorList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseLeftButtonUp="SelectorList_MouseUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="10,8" MouseLeftButtonUp="SelectorRow_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="#8AB4FF"
                                           FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="#F5F5F7" FontSize="12"
                                               FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#8E8E93" FontSize="10"
                                               FontFamily="Segoe UI" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Right}" Foreground="{Binding RightBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SelectorEmpty" Grid.Row="3" Text="" Foreground="#6E6E73" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Grid Grid.Row="4">
                <TextBlock x:Name="SelectorStatus" Text="" Foreground="#8AB4FF" FontSize="11"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="SelectorSettingsLink" Content="Manage in Settings →" Style="{StaticResource IslandFlatButton}"
                        HorizontalAlignment="Right" Click="SelectorOpenSettings_Click"/>
            </Grid>
        </Grid>

                <!-- Controls panel (iOS style): two tall sliders + circle grid -->
                <Grid Grid.Row="2" x:Name="ControlsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- one tile, both sliders -->
                    <Border Grid.Column="0" Margin="1,0,0,0" Style="{StaticResource IslandMasterTile}" x:Name="SlidersTile">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- volume -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="VolumePercent" Text="0%" Foreground="#8E8E93"
                                           FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <Border Grid.Row="1" x:Name="VolumeTrack" Width="46" CornerRadius="13"
                                        Background="#141B22" Cursor="Hand" HorizontalAlignment="Center"
                                        ClipToBounds="True" MouseDown="VolumeTrack_MouseDown"
                                        MouseMove="VolumeTrack_MouseMove" MouseUp="VolumeTrack_MouseUp">
                                    <Border x:Name="VolumeFill" Background="#F5F5F7" CornerRadius="11"
                                            VerticalAlignment="Bottom" Height="0"/>
                                </Border>
                                <Button Grid.Row="2" x:Name="MuteButton" Content="&#x1F50A;" Style="{StaticResource IslandFlatButton}"
                                        FontSize="18" Padding="4,2" Margin="0,6,0,0" Click="MuteButton_Click"
                                        ToolTip="Mute / unmute" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- brightness -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="BrightnessPercent" Text="--%" Foreground="#8E8E93"
                                           FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <Border Grid.Row="1" x:Name="BrightnessTrack" Width="46" CornerRadius="13"
                                        Background="#141B22" Cursor="Hand" HorizontalAlignment="Center"
                                        ClipToBounds="True" MouseDown="BrightnessTrack_MouseDown"
                                        MouseMove="BrightnessTrack_MouseMove" MouseUp="BrightnessTrack_MouseUp">
                                    <Border x:Name="BrightnessFill" Background="#FFD60A" CornerRadius="11"
                                            VerticalAlignment="Bottom" Height="0"/>
                                </Border>
                                <TextBlock Grid.Row="2" Text="&#x2600;" FontFamily="Segoe UI Symbol" FontSize="19"
                                           Foreground="#FFD60A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="BrightnessHint" Grid.Row="1" Text="Monitor-controlled"
                                           Foreground="#6E6E73" FontFamily="Segoe UI" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Wi-Fi tile -->
                    <Border Grid.Column="1" Margin="0,0,0,0" Style="{StaticResource IslandMasterTile}" x:Name="WifiTile">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ToggleButton x:Name="WifiToggle" Content="&#x1F4F6;" FontFamily="Segoe UI Emoji"
                                          Style="{StaticResource IslandCircleToggle}" Click="WifiToggle_Click"
                                          HorizontalAlignment="Center"/>
                            <TextBlock x:Name="WifiCaption" Text="Wi-Fi" Style="{StaticResource IslandCaption}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="WifiSubCaption" Text="Off" Style="{StaticResource IslandCaptionSub}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bluetooth tile -->
                    <Border Grid.Column="2" Margin="0,0,1,0" Style="{StaticResource IslandMasterTile}" x:Name="BluetoothTile">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ToggleButton x:Name="BluetoothToggle" Content="BT"
                                          Style="{StaticResource IslandCircleToggle}" Click="BluetoothToggle_Click"
                                          FontFamily="Segoe UI Semibold" FontSize="17" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BluetoothCaption" Text="Bluetooth" Style="{StaticResource IslandCaption}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="BluetoothSubCaption" Text="Off" Style="{StaticResource IslandCaptionSub}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- hint -->
                <TextBlock Grid.Row="3" x:Name="HintText"
                           Text="Hover to browse · pointer away to collapse"
                           Foreground="#6E6E73"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
