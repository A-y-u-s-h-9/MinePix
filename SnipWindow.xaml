<Window x:Class="MinePix.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinePix — Snip"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- dim everything except the selected region -->
        <Path x:Name="DimPath" Fill="#99000000"/>

        <!-- selection border. Must be Top/Left aligned: a Stretch-aligned Rectangle with an
             explicit Width/Height is centred in its slot, so the border drifts away from the
             region the user actually dragged (the capture rect itself was always correct). -->
        <Rectangle x:Name="SelectionBox" Stroke="#FFFFFF" StrokeThickness="1"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed" RadiusX="2" RadiusY="2"/>

        <!-- size readout -->
        <Border x:Name="SizeBadge" Visibility="Collapsed" CornerRadius="6"
                Background="#CC000000" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="SizeText" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="12"/>
        </Border>

        <TextBlock x:Name="HintText" Foreground="#FFFFFF" FontFamily="Segoe UI Semibold" FontSize="14"
                   Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                   Text="Drag to select a region   •   Enter to capture   •   Esc to cancel"/>
    </Grid>
</Window>
